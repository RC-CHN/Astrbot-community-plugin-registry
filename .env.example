# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=info
PUBLIC_CACHE_MAX_AGE=60
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456
BOOTSTRAP_ADMIN_ROLE=admin

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://astrbot:astrbot_secret@localhost:5432/astrbot_registry
DATABASE_AUTO_MIGRATE=true

# S3 (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_BUCKET=astrbot-plugins
S3_PUBLIC_URL=http://localhost:8333/astrbot-plugins
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
S3_MAX_ATTEMPTS=2
S3_PLUGINS_PREFIX=plugins
S3_UNKNOWN_AUTHOR=unknown

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
REDIS_TASK_QUEUE_KEY=registry_tasks
REDIS_TASK_DEAD_LETTER_QUEUE_KEY=registry_tasks_dead
TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_SECONDS=5

# Security scans
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=120
VIRUSTOTAL_POLL_INTERVAL_SECONDS=5
VIRUSTOTAL_MAX_POLL_ATTEMPTS=24
VIRUSTOTAL_MAX_DIRECT_UPLOAD_BYTES=33554432
LLM_AGENT_ENABLED=false
LLM_AGENT_BASE_URL=
LLM_AGENT_API_KEY=
SCAN_PASS_WHEN_UNCONFIGURED=true
SCAN_UNCONFIGURED_MESSAGE=Scan not configured

# Upload/build limits
MAX_UPLOAD_BYTES=52428800
MAX_UNZIP_BYTES=209715200
MAX_ZIP_ENTRIES=2000
MAX_SINGLE_FILE_BYTES=52428800
MAX_RELEASE_ZIP_BYTES=52428800
GIT_CLONE_TIMEOUT=120
BUILD_NETWORK_DISABLED=true
GIT_ALLOWED_HOSTS=github.com
GIT_TEMP_PREFIX=astrbot-repo-
WEBHOOK_AUTO_VERSION=auto

# Webhooks
GITHUB_WEBHOOK_SECRET=
