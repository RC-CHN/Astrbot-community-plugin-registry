# PostgreSQL
DATABASE_URL=postgresql+asyncpg://astrbot:astrbot_secret@localhost:5432/astrbot_registry

# S3 (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_BUCKET=astrbot-plugins
S3_PUBLIC_URL=http://localhost:8333/astrbot-plugins
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

# JWT
JWT_SECRET=change-me-in-production

# App
LOG_LEVEL=info
