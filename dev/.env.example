# Docker image tags
COMPOSE_PROJECT_NAME=astrbot-registry-dev
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest

# PostgreSQL
POSTGRES_CONTAINER_NAME=astrbot-registry-dev-postgres
PG_DATABASE=astrbot_registry
PG_USER=astrbot
PG_PASSWORD=astrbot_secret
PG_PORT=5432
PG_MEM_LIMIT=512m
PG_CPUS=1.0
PG_VOLUME_NAME=astrbot-registry-dev-pg-data

# Redis
REDIS_CONTAINER_NAME=astrbot-registry-dev-redis
REDIS_PORT=6379
REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_MEM_LIMIT=128m
REDIS_CPUS=0.25
REDIS_URL=redis://localhost:6379
REDIS_VOLUME_NAME=astrbot-registry-dev-redis-data

# SeaweedFS S3
SEAWEEDFS_CONTAINER_NAME=astrbot-registry-dev-seaweedfs
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminadmin
S3_PORT=8333
S3_FILER_PORT=8888
S3_MASTER_PORT=9333
S3_MEM_LIMIT=256m
S3_CPUS=0.5
S3_VOLUME_NAME=astrbot-registry-dev-s3-data

# Values to copy into ../.env when running the API on the host
DATABASE_URL=postgresql+asyncpg://astrbot:astrbot_secret@localhost:5432/astrbot_registry
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_URL=http://localhost:8333/astrbot-plugins
